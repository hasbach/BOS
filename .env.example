# BOS — local development environment template.
# Copy to .env and change every value marked CHANGE_ME. Never commit .env.

# --- Database -------------------------------------------------------------
# Owner role: creates tables and runs migrations. Not used by the running app.
POSTGRES_USER=bos_owner
POSTGRES_PASSWORD=CHANGE_ME_owner_password
POSTGRES_DB=bos
# Application role: no table ownership, cannot bypass row-level security.
BOS_APP_DB_USER=bos_app
BOS_APP_DB_PASSWORD=CHANGE_ME_app_password
# Database used only by automated tests.
BOS_TEST_DB=bos_test

# --- Ports on this computer (change if already in use) ---------------------
BOS_WEB_PORT=3000
# 127.0.0.1 = this computer only. 0.0.0.0 = also phones on the same network (development only).
BOS_WEB_BIND=127.0.0.1
BOS_MAIL_UI_PORT=8025
# Database port on this computer only, for running tests and tools outside the containers.
BOS_DB_PORT=55432
# Private PostgreSQL without Docker (python scripts/local_db.py init). When set, host-side
# tests use this port instead of BOS_DB_PORT.
BOS_LOCAL_DB_PORT=55433

# --- API --------------------------------------------------------------------
# Long random string; used to sign nothing user-visible but required by Flask.
BOS_SECRET_KEY=CHANGE_ME_long_random_string
# Public address of the web app, used to build activation and reset links.
BOS_PUBLIC_BASE_URL=http://localhost:3000
# Set to "false" only for local http development.
BOS_COOKIE_SECURE=false
# Comma-separated emails allowed to be operators (Beta Marketing Solutions staff).
BOS_OPERATOR_EMAILS=ops@example.test

# --- Email (password reset links). Mailpit captures mail locally. -----------
BOS_SMTP_HOST=mail
BOS_SMTP_PORT=1025
BOS_SMTP_USER=
BOS_SMTP_PASSWORD=
BOS_SMTP_FROM=BOS <no-reply@example.test>

# --- Demo data (flask bos seed-demo) -----------------------------------------
BOS_DEMO_PASSWORD=CHANGE_ME_demo_password

# --- Operator creation (flask bos create-operator) ---------------------------
BOS_OPERATOR_PASSWORD=CHANGE_ME_operator_password

# Allow flask bos seed-demo (creates users with known sign-in details). Never in production.
BOS_ALLOW_DEMO_SEED=true
